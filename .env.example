# Copy this file to .env.local and fill in the values you have.
# Every key is optional: without them the app shows built-in sample data.

# xAI API key for Grok (finds the stories). https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# X API v2 bearer token (adds posts to each story). https://developer.x.com/en/portal/dashboard
# BEARER_TOKEN is accepted as an alternative name.
X_BEARER_TOKEN=your_x_bearer_token_here

# SQLite cache for stories. Relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Absolute site URL for link previews. Optional; Vercel sets its own domain.
# NEXT_PUBLIC_SITE_URL=https://x-map.example.com
